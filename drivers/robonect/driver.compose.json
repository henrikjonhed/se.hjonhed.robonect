{
  "name": {
    "en": "Robonect"
  },
  "class": "other",
  "capabilities": [
    "measure_battery",
    "measure_humidity",
    "measure_temperature",
    "status_mode",
    "mode",
    "button_start",
    "button_stop",
    "button_override_start",
    "button_clear_error",
    "button_refetch_status",
    "signal",
    "timer_status",
    "blade_quality",
    "alarm_generic.stopped",
    "alarm_generic.error_active",
    "total_run_time"
  ],
  "capabilitiesOptions": {
    "button_start": {
      "title": {
        "en": "Start"
      },
      "desc": {
        "en": "Start the mower."
      }
    },
    "button_stop": {
      "title": {
        "en": "Stop"
      },
      "desc": {
        "en": "Stop the mower."
      }
    },
    "button_override_start": {
      "title": {
        "en": "Override start"
      },
      "desc": {
        "en": "Manually start an override job for the duration configured in settings."
      }
    },
    "button_clear_error": {
      "title": {
        "en": "Clear error"
      },
      "desc": {
        "en": "Clear the mower error status."
      }
    },
    "button_refetch_status": {
      "title": {
        "en": "Re-fetch status"
      },
      "desc": {
        "en": "Re-fetch the current mower status right now instead of waiting for the next scheduled update."
      }
    },
    "alarm_generic.stopped": {
      "title": {
        "en": "Stopped"
      },
      "desc": {
        "en": "The mower has stopped and needs to be manually enabled again."
      },
      "insightsTitleTrue": {
        "en": "Mower stopped"
      },
      "insightsTitleFalse": {
        "en": "Mower is no longer stopped"
      }
    },
    "alarm_generic.error_active": {
      "title": { "en": "Error active" },
      "desc": {
        "en": "Indicates if the mower has an error set or not."
      },
      "insightsTitleTrue": {
        "en": "An error has been set, see device settings for details"
      },
      "insightsTitleFalse": {
        "en": "No error is currently present"
      }
    }
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "energy": {
    "batteries": ["INTERNAL"]
  },
  "discovery": "robonect-mdns",
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "options": {
        "singular": true
      },
      "navigation": {
        "next": "address_and_credentials"
      }
    },
    {
      "id": "address_and_credentials",
      "navigation": {
        "prev": "list_devices"
      }
    },
    {
      "id": "add_device"
    }
  ],
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "value": 1,
      "min": 0.1,
      "max": 60,
      "label": {
        "en": "Polling interval (minutes)"
      },
      "hint": {
        "en": "The interval between the attempts to read an update from the mower."
      }
    },
    {
      "id": "job_duration",
      "type": "number",
      "value": 30,
      "min": 1,
      "max": 1440,
      "label": {
        "en": "Override start duration (minutes)"
      },
      "hint": {
        "en": "The duration used by the Override start device button."
      }
    },
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "IP address on local network"
      },
      "value": "x.x.x.x"
    },
    {
      "type": "group",
      "label": "Login Credentials",
      "children": [
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Username"
          },
          "value": "admin"
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          }
        }
      ]
    },
    {
      "id": "error_message",
      "type": "label",
      "label": "Current error message",
      "value": "No error is currently set"
    }
  ]
}
